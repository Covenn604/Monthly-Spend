# Required: initial administrator password (used only on first multi-user startup).
# Choose a unique password with at least 12 characters.
APP_PASSWORD=
ADMIN_USERNAME=admin
APP_IMAGE=ghcr.io/covenn604/spearmint:latest
APP_PORT=8085
# Use the default named volume, or set an absolute host directory path.
# Example: DATA_LOCATION=/your/directory/path/spearmint/data
DATA_LOCATION=spearmint-data
# Numeric host user/group IDs with write access to your data directory.
PUID=10001
PGID=10001
CURRENCY=CAD
TZ=America/Vancouver
# Set true only when accessing the app through HTTPS.
COOKIE_SECURE=false
